# Copy to .env and fill in. .env is gitignored — never commit real keys.

# === What groundy itself needs ====================================================
# groundy makes ONE call of its own — REFORMULATION (rephrasing the question) — and that's
# the only thing it needs a key for (and not even that if you inject your own
# reformulate_fn). In a real project OPENAI_API_KEY is usually already present.
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
GROUNDY_REFORMULATION_MODEL=gpt-4o-mini
# Send reformulation to a different provider than the OPENAI_* above:
# GROUNDY_REFORMULATION_BASE_URL=https://api.groq.com/openai/v1
# GROUNDY_REFORMULATION_API_KEY=gsk_...

# === Example-only: the ANSWER call ================================================
# groundy does NOT need this. It wraps your EXISTING answer call — in your project that
# function already has its own model + keys. These vars exist ONLY so examples/basic.py
# has something to answer with (it reuses OPENAI_* above for the endpoint/key). Delete
# this whole block when integrating groundy into a real codebase.
GROUNDY_ANSWER_MODEL=gpt-4o
# GROUNDY_ANSWER_BASE_URL=https://openrouter.ai/api/v1
# GROUNDY_ANSWER_API_KEY=sk-or-...

# OpenAI-compatible provider base URLs, for reference:
#   OpenRouter   https://openrouter.ai/api/v1
#   Groq         https://api.groq.com/openai/v1
#   Featherless  https://api.featherless.ai/v1

# Dev only: enable groundy debug logging (reformulations + answers). Leave unset
# in production — the library is silent unless this is truthy (1/true/yes/on).
GROUNDY_DEBUG=1
