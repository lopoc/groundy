# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: the reformulation model name (no default — groundy raises without it).
GROUNDY_MODEL=gpt-4o-mini

# Required: API key for your OpenAI-compatible provider, read by the OpenAI SDK.
OPENAI_API_KEY=sk-...

# Optional: point at any OpenAI-compatible provider (OpenRouter, Groq, a local
# server). Leave unset to use OpenAI's default endpoint.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Dev only: enable groundy debug logging (reformulations + answers). Leave unset
# in production — the library is silent unless this is truthy (1/true/yes/on).
GROUNDY_DEBUG=1
