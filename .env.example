# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: Anthropic API key for reformulations and answer calls.
ANTHROPIC_API_KEY=sk-ant-...

# Dev only: enable groundy debug logging (reformulations + answers). Leave unset
# in production — the library is silent unless this is truthy (1/true/yes/on).
GROUNDY_DEBUG=1
