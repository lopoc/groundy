# Copy to .env and fill in. .env is gitignored — never commit real keys.

# groundy needs just three things for its ONE call (reformulation), read like any OpenAI
# client: an API key, a provider, and a model name. The example reuses these to answer too.
OPENAI_API_KEY=sk-...
GROUNDY_MODEL=gpt-4o-mini

# --- optional ---------------------------------------------------------------------
# Use any OpenAI-compatible provider (OpenRouter, Groq, …); defaults to OpenAI:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Dev only: print every reformulation, answer, and score. Silent unless truthy.
# GROUNDY_DEBUG=1
